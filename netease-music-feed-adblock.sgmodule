#!name=网易云音乐 · 首页净化（增强）
#!desc=配合「网易云音乐 · 去开屏广告」使用：再清掉首页/我的页的付费投放卡、启动弹窗、首页 Banner 广告位与直播入口。需开启 MITM，且与开屏模块同时启用。
#!author=Minis
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Netease.png
#!date=2026-11-06
#!system=ios

[URL Rewrite]
# 会员/付费投放卡（账号页 SVIP、播放页开通条、首页付费卡）
^https?://interface\d?\.music\.163\.com/(x)?e?api/delivery/(batch-deliver|deliver)([?/]|$) - reject
# 启动弹窗（免流/活动弹窗）
^https?://interface\d?\.music\.163\.com/(x)?e?api/resniche/tspopup/show([?/]|$) - reject
# 首页「推荐/发现」Banner 广告位
^https?://interface\d?\.music\.163\.com/(x)?e?api/link/position/show/resource([?/]|$) - reject
# 场景化投放位
^https?://interface\d?\.music\.163\.com/(x)?e?api/link/scene/show/resource([?/]|$) - reject
# 直播入口 / 直播推荐位
^https?://interface\d?\.music\.163\.com/(x)?e?api/mlivestream/entrance([?/]|$) - reject

[MITM]
hostname = %APPEND% interface.music.163.com, interface1.music.163.com, interface3.music.163.com, interface9.music.163.com, ipv4.music.163.com, music.163.com

# 与「网易云音乐 · 去开屏广告」配套安装；若首页出现空白/加载失败，先停用本模块定位是哪一条
# 直链：https://raw.githubusercontent.com/YUANCHUANYING/surge/main/netease-music-feed-adblock.sgmodule
